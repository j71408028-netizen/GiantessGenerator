# Python 字节码
__pycache__/
*.py[codz]
*$py.class

# 虚拟环境（构建脚本还会建 .venv-build / .venv-macos）
.env
.envrc
.venv*/
env/
venv/
ENV/

# 构建 / 打包产物
# 注意：build/ 既是 PyInstaller 的产物目录，又存放构建脚本（build/windows、
# build/macos、build/linux）。整体忽略 build/ 会把构建脚本一起吞掉——入口改名、
# 图标路径写错都不会有人发现。因此只忽略 build/ 下一层（PyInstaller 的
# build/<name>/ 与 *.spec 产物），并显式放行三个脚本目录。
/build/*
!/build/windows/
!/build/macos/
!/build/linux/
!/build/release/
dist/
*.spec

# 工具缓存与测试报告
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytype/
.pyre/
.coverage
.coverage.*
htmlcov/

# IDE
/.idea
.vscode/

# 用户数据区（运行时生成，不入库）
/data/user/
/data/archives/

# 开发工具（developer_tools/ 与 scripts/）：脚本入库，产物统一写各目录下的 _out/
# 目录约定与入库范围见 developer_tools/README.md 与 scripts/README.md
/developer_tools/_out/
/scripts/_out/

# 其他本地区域
/.workbuddy/
.zcodeignore
/.temp/

# atomic 写临时文件与覆盖前备份（persistence/json_store.py）
*.bak
*.tmp

# 编辑器临时文件
tempCodeRunnerFile.py
