{
  "//": "界面配色 token 表。三层结构：primitives 原子色阶（唯一裸 hex 来源，按 Tailwind 色板命名）→ roles 语义角色（亮/暗成对，表达意图）→ vars 页面常量（引用 role/prim/pair）。",

  "primitives": {
    "//": "原子色阶。所有界面颜色的唯一裸 hex 来源；同一色相只出现一次，改品牌色只动这里。",
    "slate": {
      "0": "#FFFFFF",
      "50": "#F6F8FA",
      "100": "#EEF2F6",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A",
      "1000": "#0B0F19"
    },
    "teal": { "700": "#0F766E", "600": "#0D9488", "500": "#14B8A6", "400": "#5EEAD4", "300": "#2DD4BF" },
    "emerald": { "900": "#064E3B", "700": "#047857", "600": "#059669", "500": "#10B981", "400": "#34D399", "50": "#ECFDF5" },
    "rose": { "950": "#4C0519", "700": "#BE123C", "600": "#E11D48", "400": "#FB7185", "50": "#FFF1F2" },
    "amber": { "950": "#431407", "900": "#78350F", "800": "#9A3412", "600": "#D97706", "500": "#F59E0B", "400": "#FBBF24", "200": "#FDBA74" },
    "orange": { "700": "#C2410C", "600": "#EA580C", "400": "#FB923C", "50": "#FFF7ED" },
    "purple": { "800": "#6B21A8", "700": "#7E22CE", "400": "#C084FC", "50": "#FAF5FF" },
    "violet": { "800": "#5B21B6", "700": "#6D28D9", "400": "#A78BFA", "50": "#F5F3FF" },
    "sky": { "800": "#075985", "700": "#0369A1", "600": "#0284C7", "400": "#38BDF8", "300": "#7DD3FC", "100": "#E0F2FE" },
    "cyan": { "500": "#06B6D4" },
    "ink": { "0": "#000000" }
  },

  "roles": {
    "//": "语义角色。pair = [亮, 暗]，成员引用 primitives（family.step）。按界面意图命名：bg-* 底面、border-* 描边、text-* 文字、accent* 强调、state-* 反馈、feature-* 模块主题色。",
    "bg-app": ["slate.200", "slate.900"],
    "bg-panel": ["slate.50", "slate.800"],
    "bg-strong": ["slate.300", "slate.800"],
    "bg-alt": ["slate.100", "slate.800"],
    "bg-input": ["slate.0", "slate.800"],
    "bg-hover": ["slate.100", "slate.700"],
    "bg-menu-hover": ["slate.200", "slate.700"],
    "bg-nav-hover": ["slate.400", "slate.600"],
    "border": ["slate.300", "slate.700"],
    "border-strong": ["slate.400", "slate.600"],
    "accent": ["teal.500", "teal.300"],
    "accent-hover": ["teal.600", "teal.400"],
    "on-accent": ["slate.0", "slate.900"],
    "text-body": ["slate.800", "slate.200"],
    "text-strong": ["slate.900", "slate.100"],
    "text-label": ["slate.800", "slate.300"],
    "text-nav-title": ["slate.700", "slate.300"],
    "text-secondary": ["slate.600", "slate.400"],
    "text-muted": ["slate.500", "slate.500"],
    "text-placeholder": ["slate.400", "slate.500"],
    "text-disabled": ["slate.300", "slate.600"],
    "state-success": ["emerald.600", "emerald.400"],
    "state-success-hover": ["emerald.700", "emerald.500"],
    "state-success-tint": ["emerald.50", "emerald.900"],
    "state-danger": ["rose.600", "rose.400"],
    "state-danger-tint": ["rose.50", "rose.950"],
    "state-warning": ["amber.600", "amber.500"],
    "feature-blue": ["sky.600", "sky.400"],
    "feature-blue-light": ["sky.400", "sky.300"],
    "feature-blue-deep": ["sky.700", "sky.600"],
    "feature-blue-hover": ["sky.100", "sky.800"],
    "feature-report": ["orange.600", "orange.400"],
    "feature-report-hover": ["orange.50", "orange.700"],
    "feature-dungeon": ["purple.700", "purple.400"],
    "feature-dungeon-hover": ["purple.50", "purple.800"],
    "feature-typeview": ["violet.700", "violet.400"],
    "feature-typeview-hover": ["violet.50", "violet.800"],
    "tag-gold": ["amber.900", "amber.400"]
  },

